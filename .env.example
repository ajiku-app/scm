# Salin file ini ke .env.local untuk pengembangan lokal (vercel dev),
# atau isi sebagai Environment Variables di dashboard Vercel > Project > Settings.
#
# Semua variabel di bawah ini OPSIONAL — jika kosong, api/kpi.js memakai URL
# default (project Supabase contoh yang sama dengan versi awal dashboard ini).
# Untuk produksi, SANGAT disarankan mengisi dengan endpoint & anon key milik
# project Supabase Anda sendiri.

# Endpoint KPI dari masing-masing aplikasi sumber (harus mengembalikan JSON
# sesuai kontrak data yang ada di DATA_CONTRACT pada app.js / panel "Konfigurasi").
STOCK_API_URL=https://qbougldvlmceeqceduae.supabase.co/functions/v1/stock-monitoring-api/kpi
LOGISTICS_API_URL=https://qbougldvlmceeqceduae.supabase.co/functions/v1/logistics-api/kpi
FEFO_API_URL=https://qbougldvlmceeqceduae.supabase.co/functions/v1/fefo-monitoring-api/kpi

# Anon key Supabase, hanya dikirim server-to-server oleh api/kpi.js
# (tidak pernah terekspos ke browser).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
